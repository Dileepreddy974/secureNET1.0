# Docker Compose defaults to a local website at http://127.0.0.1:8000.
SECURENET_WEB_PORT=8000

# For a public deployment, configure all three and enable the live profile.
LAB_DOMAIN=lab.example.com
SECURENET_HTTPS=0
SECURENET_PUBLIC_ORIGIN=
# SECURENET_HTTPS=1
# SECURENET_PUBLIC_ORIGIN=https://lab.example.com

# Persistent multi-user account storage (Compose defaults are already set).
SECURENET_MAX_FILE_SIZE=104857600
SECURENET_MAX_FILES_PER_USER=100
SECURENET_MAX_STORAGE_PER_USER=10737418240
